# ===========================================================================
# Construction Portal — Backend environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env — it is gitignored for a reason.
# ===========================================================================

# --- Runtime --------------------------------------------------------------
PORT=5051
NODE_ENV=development                    # development | test | production

# --- Database -------------------------------------------------------------
# Local (pgAdmin 4 / local Postgres):
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/construction_portal
# Supabase (Connection Pooling → Session mode, port 5432):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres

DB_SSL=false                            # false for local, true for Supabase

# Required whenever DB_SSL=true. Supabase's Postgres certificate chain ends
# in a self-signed "Supabase Root 2021 CA" that no public trust store has,
# so without this the connection fails with SELF_SIGNED_CERT_IN_CHAIN.
# Get it from Dashboard → Project Settings → Database → SSL Configuration
# → Download certificate, and paste the whole PEM including BEGIN/END.
# Leave blank for local Postgres. See DEPLOYMENT.md.
DB_SSL_CA=

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
DB_APPLICATION_NAME=construction-portal-api

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
# MUST be at least 32 characters. The app refuses to boot in production
# without a real value.
JWT_SECRET=REPLACE_ME_WITH_THE_OUTPUT_OF_OPENSSL_RAND
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS / URLs ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
BASE_URL=http://localhost:5051

# --- Supabase Storage -----------------------------------------------------
# The service-role key bypasses row-level security entirely. It belongs in
# .env and in your host's dashboard — never in this file, which is committed.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_BUCKET=construction-files

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_FOLDERS=tenders,sites,workers,subcontractors,invoices,daily-updates,site-inspections,site-models,materials,labour,banking

# --- Localisation ---------------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000             # 15 minutes
RATE_LIMIT_MAX=300                      # general requests per window per IP
AUTH_RATE_LIMIT_MAX=10                  # login/register attempts per window per IP

# --- Business rules (from operations notes) -------------------------------
# How many days back a supervisor may add/edit an entry without admin access.
SUPERVISOR_EDIT_WINDOW_DAYS=2
# Extra grace day granted for banking/expense entry.
SUPERVISOR_BANKING_GRACE_DAYS=1

# --- Break-glass admin recovery -------------------------------------------
# Leave BLANK in every deployed environment. Only set locally, run the
# script, then clear. This is a deliberate authentication bypass.
BREAK_GLASS_ADMIN_EMAIL=
BREAK_GLASS_ADMIN_PASSWORD=
BREAK_GLASS_ADMIN_COMPANY_ID=