# ===========================================================================
# Construction Portal — backend configuration template
# ===========================================================================
#
# Copy to .env for local work:   cp .env.example .env
# .env is gitignored; this file is the tracked template.
#
# NO REAL VALUES BELONG IN THIS FILE. It is committed. Every value below is
# either a placeholder, a safe local default, or blank.
#
# backend/config/env.js is the ONLY place the backend reads process.env.
# Every variable below is read there; nothing else calls process.env
# directly except scripts/verifyTenantContext.js and utils/requestContext.js.
#
# Legend:
#   [REQUIRED]      the app refuses to start without it
#   [PROD]          has a working local default, but must be set in production
#   [OPTIONAL]      safe to leave unset
# ===========================================================================


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | production | test
# Drives `trust proxy`, error verbosity, and the production-only guards below.
NODE_ENV=development

# Local default is 5051. Render supplies its own PORT.
PORT=5051


# ---------------------------------------------------------------------------
# Database  [REQUIRED]
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#   Local:    postgresql://postgres:postgres@localhost:5432/construction_portal
#   Supabase: Project Settings -> Database -> Connection string (URI)
#
# See backend/database/migrations/README.md before pointing this at a fresh
# database — the migration order matters.
#
# PRODUCTION: this should connect as the `construction_app` role created by
# migration 003, NOT as `postgres`. The postgres superuser bypasses every
# row-level security policy, which makes migration 003 decorative.
DATABASE_URL=

# TLS to the database. Managed Postgres requires it.
#   Local (no TLS):  false
#   Supabase/Render: true
DB_SSL=false

# [PROD] The provider's CA bundle, so the certificate is actually verified
# rather than blindly trusted.
#
# Supabase: Project Settings -> Database -> SSL Configuration -> Download
# certificate. Paste the ENTIRE PEM including the BEGIN/END lines. It is
# multi-line; Render preserves the newlines. Do not escape them as \n.
#
# Without this, DB_SSL=true fails with SELF_SIGNED_CERT_IN_CHAIN, because
# the Supabase root CA is not in any public trust store.
DB_SSL_CA=

# Leave unset. Setting this to false THROWS at startup when
# NODE_ENV=production — an unverified TLS connection is encrypted but not
# authenticated, which defeats the point of running TLS at all.
DB_SSL_REJECT_UNAUTHORIZED=

# Connection pool sizing.
DB_POOL_MAX=10
DB_POOL_MIN=0

# Pool and query timeouts, in milliseconds. The defaults in config/env.js are
# sensible; override only with a reason.
DB_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=
DB_QUERY_TIMEOUT_MS=

# Shows up in pg_stat_activity, so a runaway query can be traced to a service.
DB_APPLICATION_NAME=construction-portal-api


# ---------------------------------------------------------------------------
# Authentication  [REQUIRED]
# ---------------------------------------------------------------------------

# [REQUIRED] Signing key for every JWT the API issues.
# MUST be at least 32 characters or the app refuses to boot.
# Generate with:  openssl rand -base64 48
#
# Rotating this invalidates every outstanding session, which is the point.
JWT_SECRET=

# Session length. Accepts the `ms` vocabulary: 7d, 12h, 30m.
JWT_EXPIRES_IN=7d

# a single access token and has no refresh-token flow; the variable appeared
# in an older template and was read nowhere (finding F-02).


# ---------------------------------------------------------------------------
# CORS and URLs
# ---------------------------------------------------------------------------

# [PROD] Comma-separated allow-list of origins permitted to call this API.
# EXACT string match — no wildcards, no prefixes, no regex.
#
# Must contain the FRONTEND origin, not the API's own. Three things have to
# agree or the browser blocks every request before it is sent:
#   1. VITE_API_URL in the frontend build
#   2. connect-src in frontend/vercel.json
#   3. this variable
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# [PROD] Where password-reset links point — the frontend, not the API.
FRONTEND_URL=http://localhost:5173

# [OPTIONAL] Public base URL of this API.
# Declared in render.yaml but read nowhere in the code. Kept here for parity
# with the blueprint; remove from both if it stays unused.
BASE_URL=


# ---------------------------------------------------------------------------
# Supabase Storage (file uploads)
# ---------------------------------------------------------------------------

# Without these three, uploads are disabled and the app still runs.
SUPABASE_URL=

# SECRET. Bypasses row-level security completely — treat as the most
# sensitive value in the system. Never commit it, never expose it to the
# browser, and rotate it if it is ever printed or shared.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_BUCKET=construction-files

# Ceiling per uploaded file, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Comma-separated allow-list of destination folders. A path outside this list
# is rejected before anything is written.
ALLOWED_UPLOAD_FOLDERS=tenders,sites,workers,subcontractors,invoices,daily-updates,site-inspections,site-models,materials,labour,banking


# ---------------------------------------------------------------------------
# Email (password reset)
# ---------------------------------------------------------------------------

# [PROD] Without SMTP configured, mailer.js logs the reset link to the
# console instead of sending it. Fine locally; in production it means a user
# who forgets their password cannot recover it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM=
MAIL_FROM_NAME=Construction Portal

# How long a password-reset link stays valid, in minutes.
RESET_TOKEN_TTL_MINUTES=


# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Window shared by both limiters, in milliseconds. 900000 = 15 minutes.
RATE_LIMIT_WINDOW_MS=900000

# General ceiling across /api.
RATE_LIMIT_MAX=300

# Tight limit on the credential endpoints. Login verifies with bcrypt at
# cost 12, so an unlimited endpoint is a cheap way to saturate the CPU.
# Only FAILED attempts count, so normal use never trips it.
AUTH_RATE_LIMIT_MAX=10

# Password reset is tighter than the rest of /api/auth: it sends email, so it
# is the favourite target for account enumeration and mail-bombing.
#
# PRODUCTION DEFAULTS: 3600000 ms (60 minutes) and 5 requests per IP. Leave
# BOTH unset in production; omitting them reproduces the original hard-coded
# behaviour exactly.
#
# Raise them ONLY for a local end-to-end run, which needs to exercise the
# recovery flow more than five times an hour:
#   PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
#   PASSWORD_RESET_RATE_LIMIT_MAX=100000
#
# An invalid value falls back to the strict production default rather than
# becoming permissive, so a typo cannot quietly unbound the limiter. The
# limiter is never disabled and there is no IP bypass.
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=
PASSWORD_RESET_RATE_LIMIT_MAX=



# ---------------------------------------------------------------------------
# Localisation
# ---------------------------------------------------------------------------

# Currency code used when a company has not chosen one.
DEFAULT_CURRENCY=INR

# IANA timezone used when a company has not chosen one. This decides when
# "today" ends for the supervisor backdated-entry rule, so it is not
# cosmetic. Must match DEFAULTS.COMPANY_TIMEZONE in config/constants.js.
DEFAULT_TIMEZONE=Asia/Kolkata


# ---------------------------------------------------------------------------
# Site operation rules
# ---------------------------------------------------------------------------

# How many days back a supervisor may record without admin approval.
SUPERVISOR_EDIT_WINDOW_DAYS=2

# Extra grace for supervisor banking entries specifically.
SUPERVISOR_BANKING_GRACE_DAYS=1


# ---------------------------------------------------------------------------
# Break-glass administrator
# ---------------------------------------------------------------------------
#
# Used ONLY by `node scripts/createBreakGlassAdmin.js` to mint an
# administrator when every admin account is locked out.
#
# LEAVE ALL THREE UNSET IN EVERY DEPLOYED ENVIRONMENT.
# Setting them in production creates a standing authentication bypass.
# render.yaml deliberately omits them for that reason.
#
# Use locally or in a maintenance window, then unset.
BREAK_GLASS_ADMIN_EMAIL=
BREAK_GLASS_ADMIN_PASSWORD=
BREAK_GLASS_ADMIN_COMPANY_ID=

# ---------------------------------------------------------------------------
# LOCAL TEST FIXTURES  (local development only — never set in production)
# ---------------------------------------------------------------------------
# Used by backend/scripts/createLocalPortalFixtures.js to create the worker
# and subcontractor accounts the browser suites need, and read by the suites
# themselves (frontend/tests/support/fixtures.js). Those suites carry NO
# default passwords: a missing variable fails immediately with the name.
#
# Leave blank here. Supply real local values on the command line or in a
# CI workflow's environment. Never commit a value.
LOCAL_ADMIN_FIXTURE_EMAIL=
LOCAL_ADMIN_FIXTURE_PASSWORD=
LOCAL_WORKER_FIXTURE_EMAIL=
LOCAL_WORKER_FIXTURE_PASSWORD=
LOCAL_SUBCONTRACTOR_FIXTURE_EMAIL=
LOCAL_SUBCONTRACTOR_FIXTURE_PASSWORD=
LOCAL_FIXTURE_COMPANY_ID=
